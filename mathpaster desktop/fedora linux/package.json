{
  "name": "mathpaster-desktop-fedora",
  "productName": "MathPaster",
  "version": "1.0.0",
  "description": "A fast visual LaTeX editor for every Fedora application.",
  "author": {
    "name": "Beny Karachun",
    "email": "beny7375@gmail.com"
  },
  "homepage": "https://mathpaster.com",
  "license": "SEE LICENSE IN ../../LICENSE",
  "main": "main.js",
  "desktopName": "com.mathpaster.MathPaster",
  "scripts": {
    "start": "sh src/launch.sh",
    "start:hidden": "sh src/launch.sh --hidden",
    "test:e2e": "node test/desktop.e2e.cjs",
    "test": "node test/launcher.test.js && node test/autostart.test.js && node test/desktop-entry.test.js && node test/kde-shortcut-cleanup.test.js && node test/kde-shortcut-listener.test.js && node test/kde-shortcut-worker-client.test.js && node test/shortcut.test.js && node test/window-state.test.js && node test/window-visibility.test.js",
    "check": "node test/check.cjs",
    "pack": "electron-builder --linux dir",
    "dist": "electron-builder --linux rpm AppImage",
    "dist:rpm": "electron-builder --linux rpm",
    "dist:appimage": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.60.0"
  },
  "build": {
    "appId": "com.mathpaster.MathPaster",
    "productName": "MathPaster",
    "artifactName": "MathPaster-${version}-${arch}.${ext}",
    "asar": true,
    "afterPack": "build/after-pack.cjs",
    "asarUnpack": [
      "src/kde-shortcut-worker.js",
      "src/kde-shortcut-listener.js",
      "node_modules/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "rpm",
        "AppImage"
      ],
      "category": "Education",
      "executableName": "mathpaster",
      "icon": "build/icons",
      "synopsis": "Visual LaTeX editor for any Fedora application",
      "description": "Write mathematics visually, copy clean LaTeX, and summon the editor anywhere with Alt+M.",
      "maintainer": "Beny Karachun <beny7375@gmail.com>",
      "vendor": "MathPaster",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "MathPaster",
          "Comment": "Write math visually and paste LaTeX anywhere",
          "Categories": "Education;Science;Utility;",
          "Keywords": "math;latex;equation;editor;",
          "StartupNotify": "true",
          "Terminal": "false",
          "Type": "Application"
        }
      }
    },
    "rpm": {
      "compression": "xz",
      "packageCategory": "Applications/Education"
    }
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  },
  "overrides": {
    "dbus-next": { "xml2js": "0.6.2" }
  }
}
